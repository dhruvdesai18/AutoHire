# Copy this file to .env and fill in your own values. .env is gitignored.

GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=your-bucket-name
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
ATS_SCORE_THRESHOLD=70
INTERVIEW_SCORE_THRESHOLD=70
BASE_URL=http://127.0.0.1:5000
SECRET_KEY=generate-with-python-secrets-token_hex-32
GOOGLE_OAUTH_CLIENT_ID=your-oauth-web-client-id.apps.googleusercontent.com
